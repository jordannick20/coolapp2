@model Grade

<div class="row">
    <div class="col my-3">

        <!-- Challenge Solution -->
        <div class="mb-3">
            <h4>Course Name</h4>
            @Model.CourseName
        </div>

        <div class="mb-3">
            <h4>Course Description</h4>
            @Model.CourseDescription
        </div>

        <div class="mb-3">
            <h4>Grade</h4>
            @Model.CourseGrade
        </div>

        <div class="mb-3">
            <h4>Comments</h4>
            @Model.Comments
        </div>

        <div class="mt-4">
            <a class="btn btn-primary" asp-controller="Grades" asp-action="Category"
               asp-route-categoryID="@Model.CategoryID">Go Back</a>
        </div>
    </div>
</div>