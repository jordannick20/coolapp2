<div class="row">
    <div class="col well">
        <form method="post">
            <h3>Add New Grade:</h3>

            <div class="mb-3">
                <label for="txtCourse">Category:</label>
                <input type="text" class="form-control" readonly />
            </div>
            <div class="mb-3">
                <label for="txtCourse">Course:</label>
                <input id="txtCourse" type="text" class="form-control" />
            </div>
            <div class="mb-3">
                <label for="txtDescription">Description:</label>
                <textarea id="txtDescription" class="form-control" rows="5" columns="50"></textarea>
            </div>
            <div class="mb-3">
                <label for="txtGrade">Grade (%):</label>
                <input id="txtGrade" type="number" class="form-control" columns="3" />
            </div>
            <div class="mb-3">
                <label for="txtComments">Comment:</label>
                <textarea id="txtComments" class="form-control" rows="5" columns="50"></textarea>
            </div>
            <div class="mb-3">
                <button type="submit" class="btn btn-primary">Add Grade</button>
            </div>
        </form>
    </div>
</div>