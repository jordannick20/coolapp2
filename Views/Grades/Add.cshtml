@model Grade

<div class="row">
    <div class="col-12 col-md-6 well">
        <form asp-controller="Grades" asp-action="Add" method="post">
            <h3>Add New Grade:</h3>

            <div class="mb-3">
                <label for="CategoryID">Category:</label>
                <input type="text" asp-for="CourseName" class="form-control" readonly />
            </div>
            <div class="mb-3">
                <label for="CourseName">Course:</label>
                <input type="text" asp-for="CourseName" class="form-control" maxlength="100" />
            </div>
            <div class="mb-3">
                <label for="CourseDescription">Description:</label>
                <textarea class="form-control" asp-for="CourseDescription" rows="5" columns="50"
                          maxlength="500"></textarea>
            </div>
            <div class="mb-3">
                <label for="CourseGrade">Grade (%):</label>
                <input type="text" asp-for="CourseGrade" class="form-control" columns="3" maxlength="3" />
            </div>
            <div class="mb-3">
                <label for="Comments">Comment:</label>
                <textarea class="form-control" asp-for="Comments" rows="5" columns="50" maxlength="500"></textarea>
            </div>
            <div class="mb-3">
                <button type="submit" class="btn btn-primary">Add Grade</button>
                <a class="btn btn-outline-primary" asp-controller="Grades" asp-action="Category"
                   asp-route-categoryID="@Model.CourseName">Cancel</a>
            </div>
        </form>
    </div>
</div>