@model GradesViewModel

<div class="row my-3">
    <div class="col">
        <form asp-controller="Grades" asp-action="Category" method="get">
            <select asp-items="@Model.CategoryList" asp-for="CategoryID" id="lstCategory" class="form-select"
                    style="max-width: 250px;" onchange="this.form.submit();"></select>
        </form>
    </div>
</div>

<div class="row">
    <div class="col">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Course Name</th>
                    <th>Grade</th>
                    <th>Comments</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Grades.Count == 0)
                {
                    <tr>
                        <td colspan="3">No courses in database...</td>
                    </tr>
                }
                @foreach (Grade item in Model.Grades)
                {
                    <tr>
                        <td><a asp-controller="Grades" asp-action="Details" asp-route-gradeID="@item.GradeID"
                                   class="text-success">@item.CourseName</a>
                        </td>
                        <td>@item.CourseGrade%</td>
                        <td>@item.Comments</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="row">
    <div class="col">
        <h4>Total Courses: @Model.Grades.Count</h4>
    </div>
</div>